<Window x:Class="BioFrequencia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BioFrequencia"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox Margin="500,100,0,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" x:Name="txtEmail" AutomationProperties.HelpText="Email"/>
        <TextBox HorizontalAlignment="Left" Margin="500,140,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtSenha" />
        <Button Content="Entrar" HorizontalAlignment="Left" Margin="531,233,0,0" VerticalAlignment="Top" x:Name="btnEntrar" Click="btnEntrar_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="421,93,0,0" TextWrapping="Wrap" Text="Email:" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="421,142,0,0" TextWrapping="Wrap" Text="Senha:" VerticalAlignment="Top"/>
        <Button x:Name="btnCadastrar" Content="Cadastrar" HorizontalAlignment="Left" Margin="614,233,0,0" VerticalAlignment="Top" Click="btnCadastrar_Click"/>

    </Grid>
</Window>
